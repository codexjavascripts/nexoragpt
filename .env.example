# Copy this file to .env and fill in the values you need.
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data

# AI Horde (anonymous key works, with lower queue priority and shared limits)
AI_HORDE_API_KEY=0000000000
AI_HORDE_CHAT_URL=https://oai.aihorde.net/v1
AI_HORDE_API_URL=https://aihorde.net/api
AI_HORDE_DEFAULT_MODEL=
AI_HORDE_CLIENT_CONTACT=
# Optional OpenAI-compatible chat override. Image generation remains on AI Horde.
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=

# SMTP mail delivery (verification and password reset require real SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NEXORAGPT <no-reply@example.com>

# Optional plugin integrations
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
